PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-this-with-a-local-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"
# When true, a request that also sends x-postly-query-trace: true receives a
# request-scoped Prisma operation trace in the GraphQL response extensions.
ENABLE_QUERY_LOG=false
# Main relation-loading implementation. During an instrumented instructor demo,
# x-postly-relation-strategy can temporarily select another comparison strategy.
RELATION_STRATEGY=dataloader
